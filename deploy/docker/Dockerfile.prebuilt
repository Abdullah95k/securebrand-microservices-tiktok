# Packages binaries built on the host (make docker-prebuilt): useful when the
# Go builder image cannot be pulled. Build with CGO_ENABLED=0 GOOS=linux.
FROM gcr.io/distroless/static-debian12:nonroot
COPY bin/ /usr/local/bin/
USER nonroot:nonroot
EXPOSE 8080 9090
ENTRYPOINT ["/usr/local/bin/fbs-api"]
